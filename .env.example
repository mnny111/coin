# Start in observation mode. API starts without these; the worker needs all four.
EXECUTION_MODE=observe
SOLANA_RPC_URL=
COIN_MINT=
CREATOR_ADDRESS=
# Unix seconds at/before your launch. Use an archival RPC for historical indexing.
START_TIME=0

# Signing key stays on the server. Never paste it into chat or commit it.
SIGNER_KEY_FILE=
# Creator fee vaults aggregate fees across launches: use a dedicated creator wallet.
DEDICATED_CREATOR_CONFIRMED=false
DATABASE_PATH=data/coin.sqlite
HOST=127.0.0.1
PORT=3000
# Optional; /admin/* is disabled unless a token of at least 32 characters is set.
ADMIN_TOKEN=

BUYBACK_BPS=7000
PAIR_BUYBACK_BPS=3000
ROUND_SECONDS=10800
SETTLEMENT_DELAY_SECONDS=120
MIN_BUYBACK_LAMPORTS=10000000
MAX_BUYBACK_LAMPORTS=100000000
GAS_RESERVE_LAMPORTS=50000000
SLIPPAGE_BPS=100
POLL_SECONDS=20
COLLECT_SECONDS=300
MAX_SCAN_PAGES=100
PRIORITY_MICROLAMPORTS=10000

# Nested listings require 100% ongoing creator-fee sharing to this wallet.
# Blank keeps every nested coin hidden. This does not enable spending from it.
NESTED_FEE_WALLET=
