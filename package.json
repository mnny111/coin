{
  "name": "coin-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "service": "node --env-file-if-exists=.env src/service.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/worker.js && node --check src/chain.js && node --check src/engine.js && node --check src/service.js && node --check src/nested-listing.js"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.3.1",
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.14",
    "@coral-xyz/anchor": "0.31.1",
    "bs58": "6.0.0"
  },
  "overrides": {
    "jayson": "5.0.0",
    "toml": "5.0.1"
  }
}
